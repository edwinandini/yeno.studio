---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://yeno.studio/</loc><changefreq>monthly</changefreq><priority>1.0</priority></url>
  <url><loc>https://yeno.studio/journal/</loc><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>https://yeno.studio/privacy/</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
  {% assign public_posts = site.posts | where_exp: "post", "post.noindex != true" %}
  {% for post in public_posts %}
  <url><loc>{{ post.url | absolute_url }}</loc><lastmod>{{ post.updated | default: post.date | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.7</priority></url>
  {% endfor %}
</urlset>
